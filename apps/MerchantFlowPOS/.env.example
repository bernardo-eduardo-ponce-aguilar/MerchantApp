# URL base del Backend NestJS corriendo en Docker local
# Para pruebas en navegador Web (localhost):
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Si pruebas desde un celular físico (Honor LX3) con Expo Go en la misma red Wi-Fi:
# Reemplaza 'localhost' por la IP de tu PC (ej: 192.168.8.61):
# EXPO_PUBLIC_API_URL=http://192.168.8.61:4000/api/v1
