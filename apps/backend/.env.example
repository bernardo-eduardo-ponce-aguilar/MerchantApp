# Entorno
NODE_ENV=development
PORT=3000

# Conexión Neon PostgreSQL (Free Tier)
# Neon provee la URL en su dashboard (Directa o Pooled).
# Recomendado para Serverless/Cloud Run y alta concurrencia: usar la conexión con '-pooler' y sslmode=require.
# Ejemplo:
# DATABASE_URL="postgresql://neondb_owner:npg_secret@ep-cool-snowflake-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/merchantflow?schema=public"

# CORS Origins permitidos (separados por coma, o * para desarrollo)
CORS_ORIGIN=*
