generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum SyncStatus {
  SYNCED
  PENDING_SYNC
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id          String     @id @default(uuid())
  categoryId  String?    @map("category_id")
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  code        String     @unique
  basePrice   Float      @map("base_price")
  cost        Float      @default(0)
  stock       Int        @default(0)
  trackStock  Boolean    @default(true) @map("track_stock")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  saleItems   SaleItem[]

  @@map("products")
}

model Shift {
  id          String     @id @default(uuid())
  cashierName String     @map("cashier_name")
  initialCash Float      @map("initial_cash")
  finalCash   Float?     @map("final_cash")
  openedAt    DateTime   @default(now()) @map("opened_at")
  closedAt    DateTime?  @map("closed_at")
  isActive    Boolean    @default(true) @map("is_active")
  syncStatus  SyncStatus @default(SYNCED) @map("sync_status")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  sales       Sale[]

  @@map("shifts")
}

model Sale {
  id            String        @id @default(uuid())
  shiftId       String        @map("shift_id")
  shift         Shift         @relation(fields: [shiftId], references: [id])
  subtotal      Float
  discountTotal Float         @default(0) @map("discount_total")
  total         Float
  totalReceived Float         @map("total_received")
  changeGiven   Float         @default(0) @map("change_given")
  status        SaleStatus    @default(COMPLETED)
  syncStatus    SyncStatus    @default(SYNCED) @map("sync_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  items         SaleItem[]
  payments      SalePayment[]

  @@map("sales")
}

model SaleItem {
  id                  String   @id @default(uuid())
  saleId              String   @map("sale_id")
  sale                Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId           String?  @map("product_id")
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String   @map("product_name_snapshot")
  quantity            Int
  unitPrice           Float    @map("unit_price")
  unitDiscount        Float    @default(0) @map("unit_discount")

  @@map("sale_items")
}

model SalePayment {
  id     String        @id @default(uuid())
  saleId String        @map("sale_id")
  sale   Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method PaymentMethod
  amount Float

  @@map("sale_payments")
}
